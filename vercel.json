{
  "buildCommand": "npm run build && echo 'BUILD_TIMESTAMP=$(date)' > .build-info",
  "outputDirectory": ".next",
  "publicSource": "./public",
  "functions": {
    "pages/api/**/*.js": {
      "maxDuration": 60
    }
  },
  "env": {
    "FORCE_BUILD": "2026-08-15-14-30-NUCLEAR"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": []
}
