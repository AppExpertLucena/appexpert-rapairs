{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "env": {
    "BUILD_ID": "2026-08-15-force-rebuild"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
